VITE_IMPORT_MEDIA_UPLOAD_TOKEN=<metadata-worker IMPORT_MEDIA_TOKEN>
IMPORT_MEDIA_TOKEN=<metadata-worker IMPORT_MEDIA_TOKEN>
# Optional override for a separate Google OAuth web client. The checked-in
# public client ID supports this repository's stable unpacked Chrome ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=<google OAuth web client ID>
VITE_VIBESEARCH_API_BASE=https://vibesearch-api.watermelons.workers.dev
VITE_VIBESEARCH_AUTH_URL=https://vibesearch-web.watermelons.workers.dev/extension-auth
VITE_NOTION_OAUTH_BROKER_BASE=https://vibesearch-api.watermelons.workers.dev
# Development builds authenticate all Vibesearch clients as this one local user.
VITE_VIBESEARCH_DEV_AUTH=true
VITE_VIBESEARCH_DEV_UID=user_demo
